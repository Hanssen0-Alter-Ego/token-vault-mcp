{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "token-vault-mcp",
  "main": "dist/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": {"enabled": false},
  "d1_databases": [{"binding":"DB","database_name":"token-vault","database_id":"REPLACE_WITH_YOUR_D1_DATABASE_ID","migrations_dir":"migrations"}]
}
